if SHIELD_LILY58_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Lily58"

# The dongle is the central; both halves become peripherals.
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left half + right half
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 Bluetooth host profiles
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
